{
  "name": "@hjawhar/og-cli",
  "version": "0.1.0",
  "description": "Local-first agentic coding CLI driving GPU inference via llama.cpp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjawhar/og-cli.git"
  },
  "homepage": "https://github.com/hjawhar/og-cli#readme",
  "bugs": "https://github.com/hjawhar/og-cli/issues",
  "keywords": [
    "agent",
    "cli",
    "llama.cpp",
    "local-first",
    "coding-assistant"
  ],
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "og": "bin/og.cjs"
  },
  "files": [
    "bin/og.cjs"
  ],
  "optionalDependencies": {
    "@hjawhar/og-cli-linux-x64": "0.1.0",
    "@hjawhar/og-cli-linux-arm64": "0.1.0",
    "@hjawhar/og-cli-darwin-x64": "0.1.0",
    "@hjawhar/og-cli-darwin-arm64": "0.1.0",
    "@hjawhar/og-cli-win32-x64": "0.1.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify --outfile dist/og src/index.ts",
    "release": "bun run tools/release.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
