{
  "name": "og-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agentic coding CLI driving GPU inference via llama.cpp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjawhar/og-ai.git",
    "directory": "og-cli"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify --outfile dist/og src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
